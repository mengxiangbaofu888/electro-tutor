# 统一换行符，避免 Windows / macOS / Linux 协作时产生整文件 diff
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary

# 锁文件在 diff 中折叠，减少噪音
package-lock.json -diff linguist-generated
